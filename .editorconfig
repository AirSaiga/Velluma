# Velluma 编辑器层统一约束（防未来漂移；与 .gitattributes 行尾安全销互补）
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Python：PEP 8 四空格
[*.py]
indent_style = space
indent_size = 4

# 前端 / 配置：两空格
[*.{js,ts,vue,json,html,css,scss,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown：保留行尾双空格（换行语义），不裁尾
[*.md]
trim_trailing_whitespace = false

# Windows 脚本必须 CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Shell 脚本必须 LF
[*.sh]
end_of_line = lf
