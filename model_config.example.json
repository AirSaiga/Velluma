{
  "_comment": "Velluma LLM / Embedding / 代理配置示例。复制为 model_config.json 并填入真实 API Key。model_config.json 已 gitignore，勿提交。schema 详见 backend/core/model_config.py。前端暴露两个槽：分析模型(reasoning，审阅/诊断/抽取等判断任务) + 写作模型(creative，正文/续写/挂件等生成任务)。建议配两个不同模型以发挥分流；分析模型留空会自动回退到写作模型。wash 槽为去 AI 味专用，UI 已隐藏，留空自动跟随写作模型。",
  "llm": {
    "reasoning": {
      "api_key": "sk-your-reasoning-api-key",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-reasoner",
      "enabled": true,
      "effort": "medium",
      "exclude": false
    },
    "creative": {
      "api_key": "sk-your-creative-api-key",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-chat",
      "enabled": false,
      "effort": "medium",
      "exclude": false
    },
    "wash": {
      "api_key": "",
      "base_url": "",
      "model": "",
      "enabled": false,
      "effort": "low"
    }
  },
  "embedding": {
    "api_key": "sk-your-dashscope-embedding-api-key",
    "model": "text-embedding-v2",
    "dimensions": 1536
  },
  "proxy": {
    "enabled": false,
    "url": "http://127.0.0.1:4780"
  }
}
