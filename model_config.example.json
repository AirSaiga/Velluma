    "creative": {
      "provider": "deepseek",
      "api_key": "sk-your-creative-api-key",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-pro",
      "enabled": false,
      "effort": "max",
      "exclude": true
    },
    "wash": {
      "provider": "deepseek",
      "api_key": "sk-your-wash-api-key",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-flash",
      "enabled": false,
      "effort": "max"
    }
  },
  "embedding": {
    "api_key": "sk-your-dashscope-embedding-api-key",
