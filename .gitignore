# ============================================================================
# Velluma .gitignore
# ============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 环境变量与密钥(切勿提交) ----
.env
.env.*
!.env.example
model_config.json

# ---- Node.js ----
node_modules/
frontend/node_modules/

# ---- 前端构建产物 ----
frontend/dist/
frontend/nul

# ---- 通用构建产物 ----
build/
dist/
*.tmp
*.bak

# ---- 运行时数据与日志 ----
data/
logs/
backend/logs/
*.log

# ---- 数据库 ----
*.db
*.sqlite3

# ---- IDE / 工具配置(个人配置,不入库) ----
.vscode/
.idea/
.trae/
.qoder/
.zcode/
*.swp
*.swo
*~

# ---- 归档与死代码 ----
backend/_archive/
backend/models_generation_task.py

# ---- 测试产物 ----
.test-dist/
coverage/

# ---- OS ----
.DS_Store
Thumbs.db
nul
