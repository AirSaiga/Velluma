# ============================================================================
# Velluma .gitignore
# ============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 环境变量与密钥(切勿提交) ----
.env
.env.*
!.env.example
model_config.json

# ---- Node.js ----
node_modules/
frontend/node_modules/
.vite/

# ---- 前端构建产物 ----
frontend/dist/
frontend/dist-electron/
frontend/nul

# ---- 通用构建产物 ----
build/
dist/
*.tmp
*.bak

# ---- 运行时数据与日志 ----
data/
logs/
backend/logs/
*.log

# ---- 数据库 ----
*.db
*.sqlite3

# ---- IDE / 工具配置(个人配置,不入库) ----
.vscode/
.idea/
.trae/
.qoder/
.zcode/
*.swp
*.swo
*~

# ---- 归档与死代码 ----
backend/_archive/

# ---- 文档(本地设计/规划文档,不入库) ----
# docs/ 根目录的核心设计文档已入库；仅 superpowers/ 工作产物本地保留
docs/superpowers/

# ---- 测试产物 ----
.test-dist/
coverage/
test_chapter_ids.json
.pytest_cache/
gui-test-screenshots/

# ---- 临时/一次性脚本(切勿提交) ----
tmp_*.py
scratch_*.py
tmp_research/

# ---- OS ----
.DS_Store
Thumbs.db
nul
