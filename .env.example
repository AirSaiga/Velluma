# Velluma 环境变量示例。复制为 .env 并按需修改（.env 已 gitignore）。
# 大多数变量有默认值，可全留空；仅当需要覆盖默认行为时取消注释。

# PostgreSQL 连接串（默认连本地 storyweaver 库；需 pgvector 扩展）
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/storyweaver

# 连接池预检（Windows 默认关，其他平台默认开；asyncpg+greenlet 兼容性考虑）
# DB_POOL_PRE_PING=false

# 固定后端端口（默认 8002 起扫描空闲端口 8002~8100；指定则跳过扫描）
# VELLUMA_PORT=8002

# 业务日志级别（默认 INFO；翻 DEBUG 可看 adaptive/上下文装配内部链路与请求入口行）
# VELLUMA_LOG_LEVEL=INFO
