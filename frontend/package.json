{
  "name": "velluma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "npm run build && electron ."
  },
  "dependencies": {
    "@tiptap/extension-bubble-menu": "^2.24.0",
    "@tiptap/extension-color": "^2.24.0",
    "@tiptap/extension-highlight": "^2.24.0",
    "@tiptap/extension-mention": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.24.0",
    "@tiptap/extension-strike": "^2.24.0",
    "@tiptap/extension-subscript": "^2.24.0",
    "@tiptap/extension-superscript": "^2.24.0",
    "@tiptap/extension-text-align": "^2.24.0",
    "@tiptap/extension-text-style": "^2.24.0",
    "@tiptap/extension-underline": "^2.24.0",
    "@tiptap/starter-kit": "^2.24.0",
    "@tiptap/vue-3": "^2.24.0",
    "@types/leaflet": "^1.9.22",
    "cytoscape": "^3.34.0",
    "leaflet": "^1.9.4",
    "markdown-it": "^14.3.0",
    "splitpanes": "^4.0.4",
    "vue": "^3.4.15",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/cytoscape": "^3.21.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.3.5",
    "@vitejs/plugin-vue": "^5.0.3",
    "autoprefixer": "^10.4.17",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^5.0.12",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.5"
  },
  "build": {
    "appId": "com.velluma.app",
    "productName": "Velluma AI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "../backend/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
