{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow Document Updater Input",
  "description": "Input schema for updating CHAPTER_GENERATION_WORKFLOW.md based on code changes",
  "type": "object",
  "required": ["changed_files", "change_type"],
  "properties": {
    "changed_files": {
      "type": "array",
      "description": "List of modified workflow files",
      "items": {
        "type": "string",
        "enum": [
          "backend/services/workflows/drafting.py",
          "backend/services/workflows/stitching.py",
          "backend/services/workflows/reviewing.py",
          "backend/services/workflows/refining.py",
          "backend/services/workflows/planning.py",
          "backend/services/workflows/dual_track.py",
          "backend/services/workflows/sketch_generator.py",
          "backend/services/workflows/adversarial_aligner.py",
          "backend/services/workflows/context.py",
          "backend/services/prompts/planner_prompts.py",
          "backend/services/prompts/draft_prompts.py",
          "backend/services/prompts/stitch_prompts.py",
          "backend/services/prompts/review_prompts.py",
          "backend/services/prompts/scene_intent_prompts.py",
          "backend/services/agentic_workflow.py"
        ]
      }
    },
    "change_type": {
      "type": "string",
      "description": "Type of code change",
      "enum": [
        "new_phase",
        "modified_prompt",
        "modified_config",
        "modified_output",
        "modified_logic",
        "modified_dependencies"
      ]
    },
    "change_description": {
      "type": "string",
      "description": "Human-readable description of the changes"
    },
    "affected_phases": {
      "type": "array",
      "description": "Phase numbers affected by the change",
      "items": {
        "type": "string",
        "enum": [
          "1",
          "2",
          "3",
          "4",
          "4.5",
          "5",
          "5.5",
          "6",
          "7",
          "8"
        ]
      }
    },
    "new_functions": {
      "type": "array",
      "description": "New functions added",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Function name"
          },
          "line_start": {
            "type": "integer",
            "description": "Starting line number"
          },
          "line_end": {
            "type": "integer",
            "description": "Ending line number"
          },
          "description": {
            "type": "string",
            "description": "Function description"
          }
        },
        "required": ["name", "line_start", "line_end", "description"]
      }
    },
    "modified_functions": {
      "type": "array",
      "description": "Modified functions",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Function name"
          },
          "line_start": {
            "type": "integer",
            "description": "New starting line number"
          },
          "line_end": {
            "type": "integer",
            "description": "New ending line number"
          },
          "changes": {
            "type": "string",
            "description": "Description of changes"
          }
        },
        "required": ["name", "line_start", "line_end", "changes"]
      }
    },
    "new_config_options": {
      "type": "array",
      "description": "New configuration options",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Config option name"
          },
          "type": {
            "type": "string",
            "description": "Data type"
          },
          "default": {
            "description": "Default value"
          },
          "description": {
            "type": "string",
            "description": "Option description"
          }
        },
        "required": ["name", "type", "default", "description"]
      }
    },
    "version_bump": {
      "type": "string",
      "description": "Type of version bump needed",
      "enum": ["major", "minor", "none"],
      "default": "none"
    }
  }
}
